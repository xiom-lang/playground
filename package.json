{
  "name": "xiom-playground",
  "version": "2.1.0",
  "private": true,
  "description": "XIOM Playground - browser lessons and a sandboxed server that compiles and runs XIOM programs",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tools/test-server.js",
    "audit:lessons": "node tools/lesson-audit.js --check-only",
    "audit:lessons:full": "node tools/lesson-audit.js",
    "audit:lessons:baseline": "node tools/lesson-audit.js --check-only --update-baseline tools/lesson-baseline.json",
    "index": "node tools/generate-index.js",
    "index:check": "node tools/generate-index.js --check",
    "stdlib:ref": "node tools/generate-stdlib-ref.js",
    "stdlib:ref:check": "node tools/generate-stdlib-ref.js --check",
    "limitations": "node tools/generate-limitations.js",
    "limitations:check": "node tools/generate-limitations.js --check",
    "expected": "node tools/generate-expected-outputs.js",
    "expected:check": "node tools/generate-expected-outputs.js --check",
    "lab:index": "node tools/generate-lab-index.js",
    "lab:index:check": "node tools/generate-lab-index.js --check",
    "lab:audit": "node tools/lab-audit.js"
  }
}
